{
  "name": "ownfleet",
  "version": "0.1.0",
  "type": "module",
  "description": "Run your own harness jobs in containers in your own cloud.",
  "license": "PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentpaca/fleet.git"
  },
  "engines": {
    "node": ">=23.6"
  },
  "files": [
    "src",
    "schemas",
    "presets",
    "examples",
    "integrations",
    "docs",
    "CHANGELOG.md"
  ],
  "bin": {
    "fleet": "src/cli/bin.mjs"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-exclude=fixtures/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov --test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
